# Cổng HTTP của backend NestJS
PORT=4000

# Origin của frontend Next.js (dùng cho CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Khoá nội bộ: frontend phải gửi header `x-api-key` với đúng giá trị này.
# Tạo mới bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKEND_API_KEY=

# Kết nối MySQL. Database DB_NAME được tự tạo (utf8mb4) nếu chưa có,
# bảng được tạo khi backend khởi động.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=business-platform

# Thư mục lưu ảnh/tệp đính kèm tải lên (tương đối so với thư mục backend)
UPLOAD_DIR=data/uploads

# Email đơn hàng gửi cho khách (đặt hàng, xác nhận, đang giao, huỷ, …).
# Để trống SMTP_HOST = TẮT: backend chỉ ghi log, không gửi.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<địa chỉ gmail>,
#        SMTP_PASSWORD=<App Password 16 ký tự VIẾT LIỀN, tạo ở myaccount.google.com/apppasswords>
# Kiểm tra cấu hình: npm run mail:test -- ban@gmail.com
SMTP_HOST=
SMTP_PORT=587
# true = SSL ngay từ đầu (cổng 465). Để trống = tự chọn theo cổng.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Người gửi hiển thị. Gmail chỉ cho gửi bằng chính địa chỉ đăng nhập (hoặc alias đã xác minh).
MAIL_FROM="UY VŨ ICT <no-reply@uyvuict.vn>"
# Khách bấm "Trả lời" thì thư về địa chỉ này (để trống = về MAIL_FROM).
MAIL_REPLY_TO=lienhe@uyvuict.vn

# Cho phép frontend mạo danh người dùng theo id tại /dev-login (công cụ dev).
# CHỈ giá trị "on" mới bật; thiếu dòng này hoặc để trống là TẮT.
# Đừng bao giờ bật trên máy chủ thật: ai gọi được API nội bộ sẽ lấy được
# phiên của bất kỳ tài khoản nào, kể cả admin.
# DEV_LOGIN=on
