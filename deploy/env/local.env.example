# Cấu hình deploy LOCAL vào WSL (Docker chạy trong WSL).
#   make init local      -> tạo deploy/env/local.env từ file này
#   make deploy local    -> build & chạy trong WSL, mở http://localhost:8080

# Thư mục cài đặt bên trong WSL (copy code sang filesystem của Linux cho nhanh).
DEPLOY_PATH=~/apps/business-platform

# ---------- Domain ----------
DOMAIN=localhost
SSL_ENABLED=false
# Cổng trên máy (Windows truy cập qua localhost nhờ WSL chuyển cổng).
HTTP_PORT=8080
HTTPS_PORT=8443

# ---------- Database ----------
DB_IMAGE=mariadb:11.4
DB_NAME=business-platform
DB_USER=business
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Mở cổng DB ra máy để xem bằng công cụ (để trống = không mở).
DB_PUBLISH_PORT=3307

# ---------- Ứng dụng ----------
AUTH_SECRET=
# Google OAuth: thêm redirect URI http://localhost:8080/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
BACKEND_API_KEY=
NEXT_PUBLIC_CKEDITOR_LICENSE_KEY=
TZ=Asia/Ho_Chi_Minh

COMPOSE_PROJECT_NAME=business-platform-local
