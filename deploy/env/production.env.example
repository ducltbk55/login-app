# Cấu hình deploy PRODUCTION.
#   make init production      -> tạo deploy/env/production.env từ file này (sinh sẵn mật khẩu/secret)
#   make deploy production    -> deploy lên máy chủ
# File production.env chứa bí mật: KHÔNG commit (đã có trong .gitignore).

# ---------- Máy chủ (SSH) ----------
SERVER_HOST=203.0.113.10
SERVER_USER=root
SERVER_PORT=22
# Khoá SSH để đăng nhập máy chủ (để trống = dùng ssh-agent / khoá mặc định).
SSH_KEY=~/.ssh/id_ed25519
# Thư mục cài đặt trên máy chủ (code ở <DEPLOY_PATH>/app, cấu hình ở <DEPLOY_PATH>/.env).
DEPLOY_PATH=/opt/business-platform
# true = tự cài Docker bằng script chính thức get.docker.com nếu máy chủ chưa có.
INSTALL_DOCKER=false

# ---------- Domain ----------
# Domain phải trỏ (bản ghi A) về SERVER_HOST trước khi deploy nếu bật SSL.
DOMAIN=example.com
# true = tự xin & gia hạn chứng chỉ Let's Encrypt, HTTP chuyển sang HTTPS.
SSL_ENABLED=true
LETSENCRYPT_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443

# ---------- Database ----------
# mariadb:11.4 (mặc định) hoặc mysql:8.4
DB_IMAGE=mariadb:11.4
DB_NAME=business-platform
DB_USER=business
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ---------- Ứng dụng ----------
# Khoá ký phiên đăng nhập (Auth.js).
AUTH_SECRET=
# Google OAuth: thêm redirect URI https://<DOMAIN>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Khoá nội bộ giữa frontend và backend.
BACKEND_API_KEY=
# Khoá thương mại CKEditor 5 (để trống = giấy phép GPL).
NEXT_PUBLIC_CKEDITOR_LICENSE_KEY=
TZ=Asia/Ho_Chi_Minh

# Tên project Docker (tên container/volume). Đổi nếu chạy nhiều bản trên một máy.
COMPOSE_PROJECT_NAME=business-platform
