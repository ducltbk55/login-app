# Chuỗi bí mật dùng để ký cookie/JWT. Tạo bằng: npx auth secret
AUTH_SECRET=

# Lấy tại https://console.cloud.google.com/apis/credentials
# (OAuth client ID -> Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# URL gốc của ứng dụng. Local có thể bỏ trống; khi deploy hãy đặt domain thật.
# AUTH_URL=https://your-domain.com

# Backend NestJS. BACKEND_API_KEY phải trùng với BACKEND_API_KEY của backend.
BACKEND_URL=http://localhost:4000/api
BACKEND_API_KEY=

# Đăng nhập nhanh bằng id tại /dev-login — chỉ chạy khi NODE_ENV != production
# VÀ request đến từ localhost. Đặt "off" để tắt hẳn ngay cả lúc dev.
# DEV_LOGIN=off
